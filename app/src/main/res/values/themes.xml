<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TMDB" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash Screen theme using androidx.core:core-splashscreen -->
    <style name="Theme.TMDB.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tmdb_dark_blue</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/tmdb_dark_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.TMDB</item>
    </style>
</resources>
